{
  "name": "tp-graphql-boutique",
  "version": "1.0.0",
  "private": true,
  "description": "TP GraphQL DaMS5 : une API de commandes avec Apollo Server",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --watch-path=src src/index.js",
    "start": "node src/index.js",
