    "test:2": "node --test tests/etape2.test.js",
    "test:3": "node --test tests/etape3.test.js",
    "test:4": "node --test tests/etape4.test.js",
    "test:bonus": "node --test tests/bonus.test.js"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "dataloader": "^2.2.3",
    "graphql": "^16.14.2"
  }
}
